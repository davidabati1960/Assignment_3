<%- include('../partials/header.ejs') %>
<%- include('../partials/main_nav.ejs') %>

<img src="/Assets/images/movie-bg.jpg" alt="Movie Background" class="bg-image">
<div class="movies-page">
  <div class="container">
    <!-- Top Header & Add Button Row -->
    <div class="movies-header">
      <h1><i class="bi bi-film"></i> <%= title %></h1>
      <a href="/movies/add" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Add a Movie
      </a>
    </div>

    <!-- Responsive Movie Table -->
    <div class="table-responsive">
      <table class="table table-dark table-striped table-hover align-middle text-center">
        <thead>
          <tr>
            <th class="text-start">Title</th>
            <th>Director</th>
            <th>Release Year</th>
            <th>Genre</th>
            <th>Rating</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% for (let count = 0; count < MovieList.length; count++) { %>
            <tr>
              <td class="text-start fw-bold"><%= MovieList[count].title %></td>
              <td><%= MovieList[count].director %></td>
              <td><%= MovieList[count].releaseYear %></td>
              <td><span class="badge bg-secondary"><%= MovieList[count].genre %></span></td>
              <td><span class="badge bg-warning text-dark">★ <%= MovieList[count].rating %> / 10</span></td>
              <td>
                <a href="/movies/edit/<%= MovieList[count]._id %>" class="btn btn-primary btn-sm">
                  <i class="fas fa-pencil-alt"></i> Edit
                </a>
                <a href="/movies/delete/<%= MovieList[count]._id %>"
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Are you sure you want to delete <%= MovieList[count].title %>?');">
                  <i class="fas fa-trash-alt"></i> Delete
                </a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer.ejs') %>
