<%- include('../partials/header.ejs') %>
<%- include('../partials/main_nav.ejs') %>
<!--  Content for the edit page -->
  <img src="/Assets/images/movie-bg.jpg" alt="Movie Background" class="bg-image">
  <div class  = "container">
    <div class="row">
    <div class="offset-md-3 col-md-6">
      <h1><%= title %></h1>

      <form class="form" method="POST">
        <div class="form-group mb-3">
          <label for="titleTextField">Movie Title</label>
          <input type="text" class="form-control" id="titleTextField"
            placeholder="Enter the movie title"
            name="title" 
            value="<%= Movie.title %>"
             required>
        </div>

        <div class="form-group mb-3">
          <label for="directorTextField">Director</label>
          <input type="text" class="form-control" id="directorTextField"
            placeholder="Enter the director's name"
            name="director"
            value="<%= Movie.director %>"
         required>
        </div>

        <div class="form-group mb-3">
          <label for="yearTextField">Release Year</label>
          <input type="number" class="form-control" id="yearTextField"
            placeholder="Enter the release year"
            name="releaseYear"
            value="<%= Movie.releaseYear %>"
            required>
        </div>

        <div class="form-group mb-3">
          <label for="genreTextField">Genre</label>
          <input type="text" class="form-control" id="genreTextField"
            placeholder="Enter the movie genre"
            name="genre"
            value="<%= Movie.genre %>"
            required>
        </div>

        <div class="form-group mb-3">
          <label for="ratingTextField">Rating </label>
          <input type="number" step="0.1" min="0" max="10" class="form-control" id="ratingTextField"
            placeholder="Enter your rating "
            name="rating"
            value="<%= Movie.rating %>"
            required>
        </div>

        <button class="btn btn-primary" type="submit">
          <i class="fas fa-edit"></i> Submit
        </button>

        <a href="/movies" class="btn btn-warning">
          <i class="fas fa-undo"></i> Cancel
        </a>
      </form>
    </div>
  </div>

    
  </div>

<%- include('../partials/footer.ejs') %>